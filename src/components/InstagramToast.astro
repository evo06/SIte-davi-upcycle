---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
---

<!--
  Antes: pop-up centralizado que interrompia a leitura, sem fundo, sem Esc
  e sem gestão de foco. Agora: aviso discreto e NÃO-modal no canto, que não
  rouba o foco nem bloqueia a página. Aparece uma vez por sessão.
-->
<aside class="toast" aria-label="Instagram" data-toast hidden>
  <div class="toast__icone">
    <Icon name="instagram" class="toast__svg" />
  </div>
  <div class="toast__texto">
    <p class="toast__titulo">Acompanhe os bastidores</p>
    <a class="toast__link" href={SITE.instagram.url} target="_blank" rel="noopener noreferrer" data-toast-link>
      Seguir {SITE.instagram.usuario}
    </a>
  </div>
  <button class="toast__fechar" type="button" aria-label="Dispensar aviso do Instagram" data-toast-fechar>
    <Icon name="close" class="toast__svg" />
  </button>
</aside>

<script>
  const toast = document.querySelector<HTMLElement>('[data-toast]')!;
  const CHAVE = 'instagramToastVisto';

  const jaVisto = () => {
    try {
      return sessionStorage.getItem(CHAVE) === '1';
    } catch {
      return false; // navegação privada pode bloquear o storage
    }
  };

  const marcarVisto = () => {
    try {
      sessionStorage.setItem(CHAVE, '1');
    } catch {}
  };

  const esconder = () => {
    toast.removeAttribute('data-visivel');
    marcarVisto();
    // Tira do DOM acessível após a saída (200ms). Timeout em vez de
    // `transitionend`, que pode nunca disparar se a transição não rodar.
    window.setTimeout(() => (toast.hidden = true), 220);
  };

  const mostrar = () => {
    toast.hidden = false;
    // Força o estado inicial ser pintado antes de animar para o final.
    requestAnimationFrame(() => requestAnimationFrame(() => toast.setAttribute('data-visivel', '')));
  };

  if (!jaVisto()) {
    // Dispara quando a pessoa chega na seção "Sobre" — já demonstrou interesse.
    const alvo = document.querySelector('#sobre');
    if (alvo) {
      const io = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        mostrar();
      });
      io.observe(alvo);
    }
  }

  toast.querySelector('[data-toast-fechar]')!.addEventListener('click', esconder);
  toast.querySelector('[data-toast-link]')!.addEventListener('click', esconder);
  toast.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') esconder();
  });
</script>

<style>
  .toast {
    position: fixed;
    left: max(1.25rem, env(safe-area-inset-left));
    bottom: max(1.25rem, env(safe-area-inset-bottom));
    z-index: 40;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    width: min(22rem, calc(100vw - 2.5rem - 4.5rem)); /* deixa espaço para o botão do WhatsApp */
    padding: 0.75rem 0.5rem 0.75rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 1rem;
    background: var(--paper);
    color: var(--ink);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.06),
      0 12px 32px -8px rgb(0 0 0 / 0.22);

    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 200ms ease,
      transform 200ms var(--ease-out);
  }

  .toast[hidden] {
    display: none;
  }

  /* Entrada ~400ms com ease suave (padrão de toasts); saída mais curta. */
  .toast[data-visivel] {
    opacity: 1;
    transform: none;
    transition:
      opacity 400ms ease,
      transform 400ms var(--ease-out);
  }

  .toast__icone {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 0.65rem;
    background: var(--ink);
    color: var(--paper);
  }

  .toast :global(.toast__svg) {
    width: 1.2rem;
    height: 1.2rem;
  }

  .toast__titulo {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.25;
  }

  .toast__link {
    font-size: 0.875rem;
    color: var(--ink-soft);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }

  .toast__fechar {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    color: var(--ink-soft);
    transition:
      color var(--dur-hover) ease,
      background-color var(--dur-hover) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .toast__fechar:hover {
      color: var(--ink);
      background: var(--paper-deep);
    }

    .toast__link:hover {
      color: var(--ink);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .toast,
    .toast[data-visivel] {
      transform: none;
    }
  }
</style>
