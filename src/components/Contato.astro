---
import Icon from './Icon.astro';
import { SITE } from '../data/site';
---

<section class="contato" id="contato" aria-labelledby="contato-titulo" data-tema="escuro">
  <div class="container">
    <div class="contato__topo">
      <p class="label"><span class="label__index">(04)</span>Contato</p>
    </div>

    <div class="contato__chamada">
      <h2 class="contato__titulo" id="contato-titulo">
        Tem um projeto <em class="serif">em mente?</em>
      </h2>
      <div class="contato__acoes">
        <p class="contato__intro">
          Orçamento, projeto sob medida ou proposta de parceria: o caminho mais direto é o WhatsApp.
        </p>
        <a class="btn btn--light contato__cta" href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">
          <Icon name="whatsapp" class="btn__icon contato__whats" />
          Conversar no WhatsApp
          <Icon name="arrow-ne" class="btn__icon btn__icon--ne" />
        </a>
      </div>
    </div>

    <dl class="contato__info">
      <div class="info">
        <dt class="info__rotulo">E-mail</dt>
        <dd><a class="link" href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
      </div>
      <div class="info">
        <dt class="info__rotulo">Telefone</dt>
        <dd><a class="link" href={SITE.telefone.href}>{SITE.telefone.exibicao}</a></dd>
      </div>
      <div class="info">
        <dt class="info__rotulo">Horário</dt>
        {
          SITE.horario.map((h) => (
            <dd>
              {h.dias}: {h.horas}
            </dd>
          ))
        }
      </div>
      <div class="info">
        <dt class="info__rotulo">Endereço</dt>
        <dd>
          <address>
            {SITE.endereco.rua}<br />
            {SITE.endereco.bairro}, {SITE.endereco.cidade}<br />
            {SITE.endereco.cep}
          </address>
          <a class="info__mapa link" href={SITE.endereco.mapa} target="_blank" rel="noopener noreferrer">
            Ver no mapa
          </a>
        </dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .contato {
    --line: var(--line-on-ink);
    --ink-soft: var(--on-ink-soft);

    padding-top: var(--section-space);
    background: var(--ink);
    color: var(--on-ink);
  }

  .contato ::selection {
    background: var(--on-ink);
    color: var(--ink);
  }

  .contato__topo {
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .contato__chamada {
    display: grid;
    gap: 2rem var(--col-gap);
    margin-block: clamp(1.5rem, 1rem + 1.5vw, 2.5rem) clamp(2rem, 1rem + 2.5vw, 3.75rem);
  }

  /* Um degrau acima dos h2: é o fechamento da página, mas não compete
     com o hero. Também considera a altura da tela. */
  .contato__titulo {
    font-size: clamp(2.4rem, min(1.2rem + 3.6vw, 9.5vh), 4.75rem);
    line-height: 0.98;
    letter-spacing: -0.032em;
    max-width: 10ch;
  }

  .contato__acoes {
    display: grid;
    gap: 1.25rem;
    align-content: end;
    justify-items: start;
  }

  .contato__intro {
    max-width: 36ch;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .contato__cta {
    min-height: 3.75rem;
    padding-inline: 1.75rem;
    font-size: 1.0625rem;
  }

  .contato :global(.contato__whats) {
    width: 1.15em;
    height: 1.15em;
    color: #128c4a; /* verde do WhatsApp escurecido: contraste sobre o botão claro */
  }

  .contato__info {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
    border-top: 1px solid var(--line);
  }

  .info {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding-block: 1.25rem;
    padding-right: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .info__rotulo {
    margin-bottom: 0.4rem;
    font-size: var(--step--1);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  .info address {
    font-style: normal;
  }

  .info__mapa {
    display: inline-block;
    margin-top: 0.6rem;
    font-size: var(--step--1);
  }

  @media (min-width: 1024px) {
    .contato__chamada {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .contato__titulo {
      grid-column: 1 / span 8;
    }

    .contato__acoes {
      grid-column: 9 / span 4;
    }

    .info {
      border-bottom: 0;
    }
  }
</style>
