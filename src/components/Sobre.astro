---
import { Picture } from 'astro:assets';
import retrato from '../assets/sobre/davi-em-processo.webp';

// Números tirados do próprio conteúdo do site (sem inventar métricas).
const numeros = [
  { valor: '10+', rotulo: 'anos de experiência em upcycling' },
  { valor: '3.000+', rotulo: 'garrafas PET em uma única obra' },
  { valor: '5 m', rotulo: 'de altura no Planeta Pet' },
];

const valores = [
  { titulo: 'Sustentabilidade', texto: 'Comprometimento com práticas sustentáveis em todo o processo criativo.' },
  { titulo: 'Originalidade', texto: 'Cada peça é única, refletindo a visão artística e o seu propósito.' },
  { titulo: 'Qualidade', texto: 'Atenção meticulosa aos detalhes para garantir durabilidade e excelência.' },
];
---

<section class="sobre" id="sobre" aria-labelledby="sobre-titulo" data-tema="escuro">
  <div class="container">
    <div class="sobre__topo">
      <p class="label"><span class="label__index">(02)</span>Sobre</p>
    </div>

    <h2 class="sobre__citacao" id="sobre-titulo">
      “Nada está perdido. Com criatividade, <em class="serif">tudo se transforma.</em>”
    </h2>

    <div class="sobre__grid">
      <figure class="sobre__figura">
        <div class="sobre__media reveal">
          <Picture
            src={retrato}
            formats={['avif']}
            fallbackFormat="webp"
            width={1400}
            widths={[480, 720, 1000, 1400]}
            sizes="(min-width: 1360px) 540px, (min-width: 900px) 40vw, 92vw"
            alt="Davi Rezende no alto de uma escada, ao lado de uma escultura gigante feita de garrafas PET azuis e verdes."
            loading="lazy"
            decoding="async"
          />
        </div>
        <figcaption class="sobre__legenda">Davi Rezende em processo de montagem</figcaption>
      </figure>

      <div class="sobre__texto">
        <h3 class="sobre__subtitulo">Transformando o comum em extraordinário</h3>
        <p>
          Especialista em upcycling, dedicado a transformar materiais descartados em peças funcionais e
          esteticamente impressionantes — sempre redefinindo o conceito de “lixo” através da criatividade e da
          inovação.
        </p>
        <p>
          São mais de 10 anos de experiência, combinando técnicas artesanais tradicionais com abordagens
          contemporâneas para criar designs únicos que contam histórias e inspiram mudanças.
        </p>

        <dl class="numeros">
          {
            numeros.map((n) => (
              <div class="numero">
                <dt class="numero__rotulo">{n.rotulo}</dt>
                <dd class="numero__valor">{n.valor}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>

    <ol class="valores">
      {
        valores.map((v, i) => (
          <li class="valor">
            <span class="valor__numero">{String(i + 1).padStart(2, '0')}</span>
            <h4 class="valor__titulo">{v.titulo}</h4>
            <p class="valor__texto">{v.texto}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .sobre {
    --line: var(--line-on-ink);
    --ink-soft: var(--on-ink-soft);

    padding-block: var(--section-space);
    background: var(--ink);
    color: var(--on-ink);
  }

  .sobre ::selection {
    background: var(--on-ink);
    color: var(--ink);
  }

  .sobre__topo {
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .sobre__citacao {
    max-width: 17ch;
    margin-block: clamp(2.5rem, 1.5rem + 3vw, 4.5rem) clamp(4rem, 2rem + 6vw, 8rem);
    font-size: var(--step-3);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  /* Aspa "pendurada" na margem, como em revistas: o texto alinha pela letra,
     não pela pontuação. Só onde a margem lateral comporta a aspa. */
  @media (min-width: 900px) {
    .sobre__citacao {
      text-indent: -0.38em;
    }
  }

  .sobre__grid {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 4vw, 5rem) var(--col-gap);
  }

  .sobre__media {
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: #2a2a27;
  }

  .sobre__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 60% 30%;
  }

  .sobre__legenda {
    padding-top: 0.85rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .sobre__texto {
    display: grid;
    align-content: start;
    gap: 1.25rem;
    max-width: 38rem;
  }

  .sobre__subtitulo {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    margin-bottom: 0.5rem;
  }

  .sobre__texto p {
    color: var(--ink-soft);
    max-width: 60ch;
  }

  .numeros {
    display: grid;
    margin-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .numero {
    display: flex;
    /* Valor em cima visualmente; a ordem semântica continua dt → dd.
       flex-end (no eixo invertido = topo) alinha os valores entre colunas
       mesmo quando os rótulos têm alturas diferentes. */
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.5rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .numero__valor {
    font-size: clamp(2.25rem, 1.6rem + 2vw, 3.4rem);
    white-space: nowrap;
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
  }

  .numero__rotulo {
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .valores {
    display: grid;
    gap: 0 var(--col-gap);
    margin-top: clamp(4rem, 2rem + 6vw, 8rem);
  }

  .valor {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.5rem 1.25rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .valor__numero {
    grid-row: span 2;
    font-size: var(--step--1);
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
    padding-top: 0.35rem;
  }

  .valor__titulo {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
  }

  .valor__texto {
    color: var(--ink-soft);
    max-width: 36ch;
  }

  @media (min-width: 640px) {
    .numeros {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: 1.5rem;
    }

    .numero {
      border-bottom: 0;
    }
  }

  @media (min-width: 900px) {
    .sobre__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .sobre__figura {
      grid-column: 1 / span 5;
    }

    .sobre__texto {
      grid-column: 7 / span 6;
      padding-top: clamp(0rem, 8vw, 8rem);
    }

    .valores {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
