---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import fotoHorizontal from '../assets/hero/planeta-pet-horizontal.jpg';
import fotoVertical from '../assets/trabalhos/planeta-pet.jpg';

/*
 * Art direction: no desktop, a foto horizontal (a obra contra o céu);
 * no celular, a vertical (a obra inteira, de pé na areia). O <picture>
 * escolhe o recorte certo e o formato mais leve (AVIF > WebP > JPG).
 */
const [desktopAvif, desktopWebp, mobileAvif, mobileWebp, fallback] = await Promise.all([
  getImage({ src: fotoHorizontal, format: 'avif', widths: [800, 1200, 1600, 2048] }),
  getImage({ src: fotoHorizontal, format: 'webp', widths: [800, 1200, 1600, 2048] }),
  getImage({ src: fotoVertical, format: 'avif', widths: [480, 720, 1080] }),
  getImage({ src: fotoVertical, format: 'webp', widths: [480, 720, 1080] }),
  getImage({ src: fotoHorizontal, format: 'jpg', width: 1200 }),
]);

const sizesDesktop = '(min-width: 1360px) 870px, 64vw';
---

<section class="hero" id="topo" aria-labelledby="hero-titulo">
  <div class="container hero__grid">
    <p class="hero__eyebrow label">
      <span class="hero__eyebrow-nome">{SITE.nome}</span>
      <span class="hero__eyebrow-sep" aria-hidden="true"></span>
      <span>Arte sustentável &amp; upcycling</span>
    </p>

    <h1 class="hero__title" id="hero-titulo">
      <span class="hero__line"><span style="--d:100ms">Transformando</span></span>
      <span class="hero__line"><span style="--d:190ms">o <em class="serif">descartado</em> em arte.</span></span>
    </h1>

    <div class="hero__aside hero__fade">
      <p class="hero__lead">
        Esculturas, mobiliário e instalações que unem sustentabilidade e design exclusivo, criados a partir do
        que seria jogado fora.
      </p>
      <div class="hero__actions">
        <a class="btn" href="#trabalhos">
          Ver trabalhos
          <Icon name="arrow-s" class="btn__icon btn__icon--s" />
        </a>
        <a class="btn btn--ghost" href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">
          Fale comigo
          <Icon name="arrow-ne" class="btn__icon btn__icon--ne" />
        </a>
      </div>
      <p class="hero__place">Rio de Janeiro, Brasil</p>
    </div>

    <figure class="hero__figure">
      <div class="hero__media">
        <picture>
          <source media="(min-width: 768px)" type="image/avif" srcset={desktopAvif.srcSet.attribute} sizes={sizesDesktop} />
          <source media="(min-width: 768px)" type="image/webp" srcset={desktopWebp.srcSet.attribute} sizes={sizesDesktop} />
          <source type="image/avif" srcset={mobileAvif.srcSet.attribute} sizes="100vw" />
          <source type="image/webp" srcset={mobileWebp.srcSet.attribute} sizes="100vw" />
          <img
            src={fallback.src}
            width={fallback.attributes.width}
            height={fallback.attributes.height}
            alt="Planeta Pet: globo gigante feito com milhares de garrafas PET azuis e verdes, com uma placa de madeira, contra o céu azul."
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </div>
      <figcaption class="hero__caption hero__fade">
        <span class="hero__caption-title">Planeta Pet</span>
        <span>+3.000 garrafas PET · 5 m · Saquarema, RJ</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(2.5rem, 1rem + 5vw, 5.5rem));
    padding-bottom: var(--section-space);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem var(--col-gap);
  }

  .hero__eyebrow {
    color: var(--ink-soft);
    flex-wrap: wrap;
    align-items: center;
  }

  .hero__eyebrow-sep {
    width: 2rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  /* Tipografia monumental: entrelinha curta e tracking negativo em
     tamanhos grandes (o espaçamento padrão fica "frouxo" quando a letra cresce). */
  .hero__title {
    font-size: var(--step-4);
    line-height: 0.92;
    letter-spacing: -0.045em;
    font-weight: 500;
    margin-top: -0.5rem;
  }

  .hero__title .serif {
    letter-spacing: -0.02em;
  }

  /* Cada linha é uma "janela": o texto sobe de dentro dela.
     O padding extra evita cortar descendentes (g, p) e o itálico. */
  .hero__line {
    display: block;
    overflow: hidden;
    padding: 0 0.12em 0.12em 0;
    margin-bottom: -0.12em;
  }

  .hero__line > span {
    display: block;
  }

  .hero__aside {
    display: grid;
    gap: 1.75rem;
    align-content: start;
  }

  .hero__lead {
    max-width: 34ch;
    font-size: var(--step-1);
    line-height: 1.4;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__place {
    font-size: var(--step--1);
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }

  .hero__figure {
    margin-top: 0.5rem;
  }

  /* Mobile/tablet: a obra sobe para logo após o título, para aparecer já na
     primeira tela. Só muda a ordem visual — a figura não tem itens focáveis,
     então a ordem de navegação por teclado continua coerente. */
  @media (max-width: 1023px) {
    .hero__figure {
      order: 1;
    }

    .hero__aside {
      order: 2;
      margin-top: 1rem;
    }
  }

  @media (max-width: 639px) {
    .hero__eyebrow-nome,
    .hero__eyebrow-sep {
      display: none; /* o nome já está no header */
    }

    .hero__actions .btn {
      flex: 1 1 auto;
    }
  }

  .hero__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    background: var(--paper-deep);
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .hero__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-top: 0.85rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .hero__caption-title {
    color: var(--ink);
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .hero__media {
      aspect-ratio: 3 / 2;
    }

    .hero__media img {
      object-position: 30% 50%;
    }
  }

  @media (min-width: 1024px) {
    .hero__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      row-gap: clamp(2.5rem, 1rem + 3vw, 4.5rem);
    }

    .hero__eyebrow,
    .hero__title {
      grid-column: 1 / -1;
    }

    .hero__aside {
      grid-column: 1 / span 4;
      align-self: start;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
    }

    .hero__figure {
      grid-column: 5 / -1;
      margin-top: 0;
    }

    .hero__media {
      aspect-ratio: 16 / 10;
    }
  }

  /* ---- Entrada (uma vez, ao carregar) -------------------------------------
     Hierarquia: o título lidera, a imagem acompanha, os textos de apoio
     chegam por último e o rótulo só esmaece (decoração não se desloca).
     `both` mantém o estado inicial durante o delay: nada "pisca". */
  @media (prefers-reduced-motion: no-preference) {
    .hero__eyebrow {
      animation: hero-fade 700ms ease both;
    }

    .hero__line > span {
      animation: hero-rise 1100ms var(--ease-out) both;
      animation-delay: var(--d);
    }

    .hero__fade {
      animation: hero-fade-up 900ms var(--ease-out) both 520ms;
    }

    .hero__media {
      animation: hero-unclip 1300ms var(--ease-out) both 220ms;
    }

    .hero__media img {
      animation: hero-settle 1800ms var(--ease-out) both 220ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title,
    .hero__media,
    .hero__fade {
      animation: hero-fade 400ms ease both;
    }
  }

  @keyframes hero-rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes hero-unclip {
    from {
      clip-path: inset(10% 6% 0 6%);
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.12);
    }
  }
</style>
