---
import { getImage } from 'astro:assets';
import Icon from './Icon.astro';
import { SITE } from '../data/site';
import fotoHorizontal from '../assets/hero/planeta-pet-horizontal.jpg';
import fotoVertical from '../assets/trabalhos/planeta-pet.jpg';

/*
 * Art direction: no desktop, a foto horizontal (a obra contra o céu);
 * no celular, a vertical (a obra inteira, de pé na areia). O <picture>
 * escolhe o recorte certo e o formato mais leve (AVIF > WebP > JPG).
 */
const [desktopAvif, desktopWebp, mobileAvif, mobileWebp, fallback] = await Promise.all([
  getImage({ src: fotoHorizontal, format: 'avif', widths: [800, 1200, 1600, 2048] }),
  getImage({ src: fotoHorizontal, format: 'webp', widths: [800, 1200, 1600, 2048] }),
  getImage({ src: fotoVertical, format: 'avif', widths: [480, 720, 1080] }),
  getImage({ src: fotoVertical, format: 'webp', widths: [480, 720, 1080] }),
  getImage({ src: fotoHorizontal, format: 'jpg', width: 1200 }),
]);

// Desktop: a foto ocupa a metade direita; tablet: largura total.
const sizesDesktop = '(min-width: 1360px) 680px, (min-width: 1024px) 50vw, 100vw';
---

<section class="hero" id="topo" aria-labelledby="hero-titulo">
  <div class="container hero__grid">
    <div class="hero__texto">
      <p class="hero__eyebrow label">
        <span class="hero__eyebrow-nome">{SITE.nome}</span>
        <span class="hero__eyebrow-sep" aria-hidden="true"></span>
        <span>Arte sustentável &amp; upcycling</span>
      </p>

      <!-- Três linhas fixas: cada uma é uma "janela" da animação de entrada,
           e a quebra fica igual em qualquer tela (sem palavra órfã). -->
      <h1 class="hero__title" id="hero-titulo">
        <span class="hero__line"><span style="--d:100ms">Transformando</span></span>
        <span class="hero__line"><span style="--d:180ms">o <em class="serif">descartado</em></span></span>
        <span class="hero__line"><span style="--d:245ms">em arte.</span></span>
      </h1>

      <div class="hero__aside hero__fade">
        <p class="hero__lead">
          Esculturas, mobiliário e instalações feitos com o que seria jogado fora: garrafas PET, leques, plástico
          doméstico, até o capô de um Fusca.
        </p>
        <div class="hero__actions">
          <a class="btn" href="#trabalhos">
            Ver trabalhos
            <Icon name="arrow-s" class="btn__icon btn__icon--s" />
          </a>
          <a class="btn btn--ghost" href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">
            Fale comigo
            <Icon name="arrow-ne" class="btn__icon btn__icon--ne" />
          </a>
        </div>
        <p class="hero__place">Rio de Janeiro, Brasil</p>
      </div>
    </div>

    <figure class="hero__figure">
      <div class="hero__media">
        <picture>
          <source media="(min-width: 768px)" type="image/avif" srcset={desktopAvif.srcSet.attribute} sizes={sizesDesktop} />
          <source media="(min-width: 768px)" type="image/webp" srcset={desktopWebp.srcSet.attribute} sizes={sizesDesktop} />
          <source type="image/avif" srcset={mobileAvif.srcSet.attribute} sizes="100vw" />
          <source type="image/webp" srcset={mobileWebp.srcSet.attribute} sizes="100vw" />
          <img
            src={fallback.src}
            width={fallback.attributes.width}
            height={fallback.attributes.height}
            alt="Planeta Pet: globo gigante feito com milhares de garrafas PET azuis e verdes, com uma placa de madeira, contra o céu azul."
            loading="eager"
            fetchpriority="high"
          />
        </picture>
      </div>
      <figcaption class="hero__caption hero__fade">
        <span class="hero__caption-title">Planeta Pet</span>
        <span>+3.000 garrafas PET · 5 m · Saquarema, RJ</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .hero {
    padding-top: calc(var(--header-h) + clamp(1rem, 4vh, 2.5rem));
    padding-bottom: clamp(1.5rem, 5vh, 3rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem var(--col-gap);
  }

  /* Mobile/tablet: o wrapper "some" do layout e os filhos entram direto no
     grid, para a obra aparecer entre o título e o texto (ordem visual; a
     figura não tem itens focáveis, então a navegação por teclado não muda). */
  .hero__texto {
    display: contents;
  }

  .hero__figure {
    order: 1;
  }

  .hero__aside {
    order: 2;
  }

  .hero__eyebrow {
    color: var(--ink-soft);
    flex-wrap: wrap;
    align-items: center;
  }

  .hero__eyebrow-sep {
    width: 2rem;
    height: 1px;
    background: currentColor;
    opacity: 0.6;
  }

  /* Título: entrelinha curta e tracking negativo moderado (o espaçamento
     padrão fica "frouxo" em tamanhos grandes). O tamanho vem de --step-4,
     que considera largura E altura da tela. */
  .hero__title {
    font-size: var(--step-4);
    line-height: 0.98;
    letter-spacing: -0.032em;
    font-weight: 500;
  }

  .hero__title .serif {
    letter-spacing: -0.015em;
  }

  /* Cada linha é uma "janela": o texto sobe de dentro dela.
     O padding extra evita cortar descendentes (g, p) e o itálico. */
  .hero__line {
    display: block;
    overflow: hidden;
    padding: 0 0.12em 0.1em 0;
    margin-bottom: -0.1em;
  }

  .hero__line > span {
    display: block;
  }

  .hero__aside {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }

  .hero__lead {
    max-width: 36ch;
    font-size: var(--step-1);
    line-height: 1.45;
    color: var(--ink-soft);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__place {
    font-size: var(--step--1);
    color: var(--ink-soft);
    letter-spacing: 0.02em;
  }

  .hero__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-height: 62vh;
    max-height: 62svh;
    background: var(--paper-deep);
  }

  /* O <picture> ocupa a caixa inteira; sem isso, o height: 100% da imagem
     não tem referência e sobra uma faixa vazia quando a caixa muda de proporção. */
  .hero__media picture {
    position: absolute;
    inset: 0;
  }

  .hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }

  .hero__caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    padding-top: 0.75rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  .hero__caption-title {
    color: var(--ink);
    font-weight: 500;
  }

  @media (min-width: 768px) {
    .hero__media {
      aspect-ratio: 3 / 2;
    }

    .hero__media img {
      object-position: 30% 50%;
    }
  }

  @media (max-width: 639px) {
    .hero__eyebrow-nome,
    .hero__eyebrow-sep {
      display: none; /* o nome já está no header */
    }

    .hero__actions .btn {
      flex: 1 1 auto;
    }
  }

  /* Notebook/desktop: o hero inteiro cabe numa tela (100svh).
     Texto à esquerda, alinhado embaixo; a obra preenche a altura à direita.
     svh = altura da tela "pequena" (com barras do navegador visíveis), para
     nada ficar escondido atrás delas. O teto evita um hero gigante em
     monitores muito altos. */
  @media (min-width: 1024px) {
    .hero {
      display: flex;
      flex-direction: column;
      min-height: clamp(36rem, 100vh, 68rem);
      min-height: clamp(36rem, 100svh, 68rem);
    }

    .hero__grid {
      flex: 1;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: stretch;
    }

    .hero__texto {
      grid-column: 1 / span 6;
      display: flex;
      flex-direction: column;
      gap: clamp(1.25rem, 3.5vh, 2.25rem);
      padding-bottom: 2rem; /* alinha a base do texto com a base da foto (acima da legenda) */
    }

    .hero__title {
      margin-top: auto;
    }

    .hero__figure {
      grid-column: 7 / -1;
      display: flex;
      flex-direction: column;
      min-height: 0;
    }

    .hero__media {
      flex: 1;
      aspect-ratio: auto;
      max-height: none;
      min-height: 18rem;
    }
  }

  /* ---- Entrada (uma vez, ao carregar) -------------------------------------
     Hierarquia: o título lidera (linhas em sequência curta e desigual:
     0 / 80 / 65ms), a imagem acompanha, os textos de apoio chegam por último
     e o rótulo só esmaece (decoração não se desloca).
     `both` mantém o estado inicial durante o delay: nada "pisca". */
  @media (prefers-reduced-motion: no-preference) {
    .hero__eyebrow {
      animation: hero-fade 700ms ease both;
    }

    .hero__line > span {
      animation: hero-rise 1100ms var(--ease-out) both;
      animation-delay: var(--d);
    }

    .hero__fade {
      animation: hero-fade-up 900ms var(--ease-out) both 520ms;
    }

    .hero__media {
      animation: hero-unclip 1300ms var(--ease-out) both 220ms;
    }

    .hero__media img {
      animation: hero-settle 1800ms var(--ease-out) both 220ms;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__title,
    .hero__media,
    .hero__fade {
      animation: hero-fade 400ms ease both;
    }
  }

  @keyframes hero-rise {
    from {
      transform: translateY(105%);
    }
  }

  @keyframes hero-fade {
    from {
      opacity: 0;
    }
  }

  @keyframes hero-fade-up {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }

  @keyframes hero-unclip {
    from {
      clip-path: inset(8% 5% 0 5%);
    }
  }

  @keyframes hero-settle {
    from {
      transform: scale(1.1);
    }
  }
</style>
