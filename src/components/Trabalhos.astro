---
import { Picture, getImage } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import Icon from './Icon.astro';
import { TRABALHOS } from '../data/trabalhos';
import { SITE } from '../data/site';

const contagem = TRABALHOS.reduce<Record<string, number>>((acc, t) => {
  acc[t.categoria] = (acc[t.categoria] ?? 0) + 1;
  return acc;
}, {});
const filtros = [
  { nome: 'Todos', total: TRABALHOS.length },
  ...Object.entries(contagem)
    .sort((a, b) => b[1] - a[1])
    .map(([nome, total]) => ({ nome, total })),
];

// Versão ampliada (lightbox): a obra inteira, sem corte, em alta resolução.
const obras = await Promise.all(
  TRABALHOS.map(async (t, i) => {
    // Obs.: nunca ler propriedades da imagem importada (ex.: t.imagem.width).
    // No Astro, isso marca o arquivo original como "usado" e ele é copiado
    // inteiro para o build. As dimensões vêm do resultado (`attributes`).
    // O Astro já descarta larguras maiores que a original.
    const ampliada = await getImage({ src: t.imagem, format: 'webp', widths: [800, 1280, 1800] });
    return { ...t, numero: String(i + 1).padStart(2, '0'), ampliada };
  }),
);

/* `sizes` diz ao navegador a largura que cada card ocupa no grid editorial
   (ver CSS abaixo), para ele baixar só a versão de imagem necessária. */
const sizes = '(min-width: 1360px) 560px, (min-width: 1024px) 40vw, (min-width: 640px) 46vw, 92vw';
---

<section class="trabalhos" id="trabalhos" aria-labelledby="trabalhos-titulo">
  <div class="container">
    <SectionHeader index="01" label="Trabalhos" titleId="trabalhos-titulo">
      Obras <em class="serif">selecionadas</em>
      <p slot="intro">
        De garrafas PET a um capô de Fusca: obras feitas para marcas, eventos e espaços.
      </p>
      <div slot="aside" class="filtros" role="group" aria-label="Filtrar obras por categoria">
        {
          filtros.map((f, i) => (
            <button class="filtro" type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-filtro={f.nome}>
              {f.nome}
              <span class="filtro__total">{f.total}</span>
            </button>
          ))
        }
      </div>
    </SectionHeader>

    <ul class="obras" data-obras>
      {
        obras.map((obra, i) => (
          <li class="obra" data-categoria={obra.categoria}>
            <a
              class="obra__link"
              href={obra.ampliada.src}
              data-index={i}
              data-titulo={obra.titulo}
              data-categoria={obra.categoria}
              data-contexto={obra.contexto ?? ''}
              data-descricao={obra.descricao ?? ''}
              data-srcset={obra.ampliada.srcSet.attribute}
              data-src={obra.ampliada.src}
              data-largura={obra.ampliada.attributes.width}
              data-altura={obra.ampliada.attributes.height}
              data-video={obra.video ?? ''}
              aria-label={`Ver obra: ${obra.titulo}`}
            >
              <div class="obra__media reveal">
                <Picture
                  src={obra.imagem}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[400, 640, 900, 1200]}
                  sizes={sizes}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  style={obra.foco ? `object-position:${obra.foco}` : undefined}
                />
                {obra.video && (
                  <span class="obra__badge">
                    <Icon name="play" class="obra__badge-icon" />
                    Vídeo
                  </span>
                )}
              </div>
            </a>
            <div class="obra__meta">
              <span class="obra__numero">{obra.numero}</span>
              <div class="obra__textos">
                <h3 class="obra__titulo">{obra.titulo}</h3>
                {obra.contexto && <p class="obra__contexto">{obra.contexto}</p>}
              </div>
              <span class="obra__categoria">{obra.categoria}</span>
            </div>
          </li>
        ))
      }
    </ul>

    <div class="trabalhos__cta">
      <p>Quer uma peça sob encomenda?</p>
      <a class="btn" href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">
        Pedir orçamento
        <Icon name="arrow-ne" class="btn__icon btn__icon--ne" />
      </a>
    </div>
  </div>

  <!-- Visualização ampliada. <dialog> nativo = foco preso, Esc fecha
       e o resto da página fica inerte, sem biblioteca. -->
  <dialog class="lightbox" aria-labelledby="lightbox-titulo" data-lightbox>
    <div class="lightbox__bar">
      <p class="lightbox__contador" aria-live="polite" data-lb-contador></p>
      <button class="lightbox__fechar" type="button" data-lb-fechar>
        Fechar <Icon name="close" class="lightbox__icone" />
      </button>
    </div>

    <figure class="lightbox__figura">
      <div class="lightbox__palco" data-lb-palco>
        <img class="lightbox__img" alt="" data-lb-img />
        <video class="lightbox__video" playsinline controls muted loop preload="none" hidden data-lb-video></video>
      </div>
      <figcaption class="lightbox__legenda">
        <div>
          <p class="lightbox__meta" data-lb-meta></p>
          <h3 class="lightbox__titulo" id="lightbox-titulo" data-lb-titulo></h3>
        </div>
        <p class="lightbox__descricao" data-lb-descricao></p>
        <div class="lightbox__nav">
          <button class="lightbox__seta" type="button" aria-label="Obra anterior" data-lb-anterior>
            <Icon name="arrow-left" class="lightbox__icone" />
          </button>
          <button class="lightbox__seta" type="button" aria-label="Próxima obra" data-lb-proxima>
            <Icon name="arrow-right" class="lightbox__icone" />
          </button>
        </div>
      </figcaption>
    </figure>
  </dialog>
</section>

<script>
  const secao = document.querySelector<HTMLElement>('#trabalhos')!;
  const lista = secao.querySelector<HTMLElement>('[data-obras]')!;
  const itens = [...lista.querySelectorAll<HTMLLIElement>('.obra')];
  const botoes = [...secao.querySelectorAll<HTMLButtonElement>('[data-filtro]')];
  const reduz = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* ---- Filtro ----
     Troca de filtro é uma ação repetitiva (como trocar de aba): sem
     coreografia. Só um esmaecer curto para a troca não ser "seca". */
  botoes.forEach((botao) => {
    botao.addEventListener('click', () => {
      const filtro = botao.dataset.filtro!;
      botoes.forEach((b) => b.setAttribute('aria-pressed', String(b === botao)));
      itens.forEach((item) => {
        item.hidden = filtro !== 'Todos' && item.dataset.categoria !== filtro;
      });
      if (!reduz.matches) {
        lista.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 240, easing: 'ease-out' });
      }
    });
  });

  /* ---- Lightbox ---- */
  const dialog = secao.querySelector<HTMLDialogElement>('[data-lightbox]')!;
  const el = {
    img: dialog.querySelector<HTMLImageElement>('[data-lb-img]')!,
    video: dialog.querySelector<HTMLVideoElement>('[data-lb-video]')!,
    titulo: dialog.querySelector<HTMLElement>('[data-lb-titulo]')!,
    meta: dialog.querySelector<HTMLElement>('[data-lb-meta]')!,
    descricao: dialog.querySelector<HTMLElement>('[data-lb-descricao]')!,
    contador: dialog.querySelector<HTMLElement>('[data-lb-contador]')!,
    palco: dialog.querySelector<HTMLElement>('[data-lb-palco]')!,
  };

  let visiveis: HTMLAnchorElement[] = [];
  let atual = 0;
  let origem: HTMLElement | null = null;

  const pad = (n: number) => String(n).padStart(2, '0');

  const mostrar = (posicao: number) => {
    atual = (posicao + visiveis.length) % visiveis.length;
    const d = visiveis[atual].dataset;

    el.img.srcset = d.srcset!;
    el.img.sizes = '(min-width: 1024px) 70vw, 100vw';
    el.img.src = d.src!;
    el.img.width = Number(d.largura);
    el.img.height = Number(d.altura);
    el.img.alt = d.titulo!;

    if (d.video) {
      el.video.poster = d.src!;
      el.video.src = d.video;
      el.video.hidden = false;
      el.img.hidden = true;
      el.video.play().catch(() => {});
    } else {
      el.video.pause();
      el.video.removeAttribute('src');
      el.video.hidden = true;
      el.img.hidden = false;
    }

    el.titulo.textContent = d.titulo!;
    el.meta.textContent = [d.categoria, d.contexto].filter(Boolean).join(' · ');
    el.descricao.textContent = d.descricao ?? '';
    el.descricao.hidden = !d.descricao;
    el.contador.textContent = `${pad(atual + 1)} / ${pad(visiveis.length)}`;
  };

  const abrir = (link: HTMLAnchorElement) => {
    visiveis = itens.filter((i) => !i.hidden).map((i) => i.querySelector<HTMLAnchorElement>('.obra__link')!);
    origem = link;
    mostrar(visiveis.indexOf(link));
    dialog.showModal();
    document.documentElement.style.overflow = 'hidden';
  };

  const fechar = () => dialog.close();

  dialog.addEventListener('close', () => {
    el.video.pause();
    document.documentElement.style.overflow = '';
    origem?.focus({ preventScroll: true });
  });

  lista.addEventListener('click', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLAnchorElement>('.obra__link');
    // Ctrl/Cmd+clique continua abrindo a imagem em nova aba (comportamento nativo).
    if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    abrir(link);
  });

  dialog.querySelector('[data-lb-fechar]')!.addEventListener('click', fechar);
  dialog.querySelector('[data-lb-anterior]')!.addEventListener('click', () => mostrar(atual - 1));
  dialog.querySelector('[data-lb-proxima]')!.addEventListener('click', () => mostrar(atual + 1));

  // Clique no fundo (fora da obra e da legenda) fecha.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog || e.target === el.palco) fechar();
  });

  // Navegação por teclado — troca instantânea: é uma ação repetida.
  dialog.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') mostrar(atual + 1);
    if (e.key === 'ArrowLeft') mostrar(atual - 1);
  });

  // Swipe horizontal no celular: decide pela distância OU pela velocidade
  // (um "peteleco" rápido e curto também conta).
  let inicioX = 0;
  let inicioY = 0;
  let inicioT = 0;
  el.palco.addEventListener(
    'pointerdown',
    (e) => {
      if (e.pointerType === 'mouse') return;
      inicioX = e.clientX;
      inicioY = e.clientY;
      inicioT = performance.now();
    },
    { passive: true },
  );
  el.palco.addEventListener(
    'pointerup',
    (e) => {
      if (e.pointerType === 'mouse' || !inicioT) return;
      const dx = e.clientX - inicioX;
      const dy = e.clientY - inicioY;
      const velocidade = Math.abs(dx) / (performance.now() - inicioT);
      inicioT = 0;
      if (Math.abs(dx) < Math.abs(dy)) return;
      if (Math.abs(dx) > 60 || velocidade > 0.4) mostrar(dx < 0 ? atual + 1 : atual - 1);
    },
    { passive: true },
  );
</script>

<style>
  .trabalhos {
    padding-bottom: var(--section-space);
  }

  /* ---- Filtros ---- */
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }

  .filtro {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.3rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--ink-soft);
    transition: color var(--dur-hover) ease;
  }

  .filtro::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.55rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-ui) var(--ease-out);
  }

  .filtro[aria-pressed='true'] {
    color: var(--ink);
  }

  .filtro[aria-pressed='true']::after {
    transform: none;
  }

  .filtro__total {
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
    transform: translateY(-0.45em);
  }

  @media (hover: hover) and (pointer: fine) {
    .filtro:hover {
      color: var(--ink);
    }
  }

  /* ---- Grid de obras ---- */
  .obras {
    display: grid;
    gap: clamp(2.5rem, 1.5rem + 3vw, 4rem) var(--col-gap);
  }

  .obra {
    position: relative;
  }

  .obra[hidden] {
    display: none;
  }

  .obra__link {
    display: block;
    cursor: zoom-in;
  }

  /* O link cobre o card todo (imagem + legenda), mas só a imagem fica
     dentro do <a>: assim o título continua sendo um h3 válido. */
  .obra__link::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .obra__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    max-height: var(--media-max-h); /* nunca mais alta que a tela */
    background: var(--paper-deep);
  }

  .obra__media :global(picture) {
    display: block;
    height: 100%;
    transition: transform 900ms var(--ease-out);
  }

  .obra__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .obra__badge {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.7rem 0.35rem 0.55rem;
    border-radius: 999px;
    background: rgb(21 21 19 / 0.72);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: var(--on-ink);
    font-size: 0.75rem;
    font-weight: 500;
  }

  .obra__media :global(.obra__badge-icon) {
    width: 0.9rem;
    height: 0.9rem;
  }

  .obra__meta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.9rem;
    padding-top: 1rem;
  }

  .obra__numero,
  .obra__categoria {
    font-size: var(--step--1);
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
  }

  .obra__titulo {
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    line-height: 1.2;
  }

  .obra__contexto {
    margin-top: 0.2rem;
    font-size: var(--step--1);
    color: var(--ink-soft);
  }

  /* Hover só com mouse: a imagem aproxima de leve (sinaliza que é clicável). */
  @media (hover: hover) and (pointer: fine) {
    .obra:hover .obra__media :global(picture) {
      transform: scale(1.035);
    }
  }

  /* Tablet: duas colunas, a segunda deslocada para baixo. */
  @media (min-width: 640px) and (max-width: 1023px) {
    .obras {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .obra:nth-child(even of :not([hidden])) {
      margin-top: clamp(2rem, 7vw, 4rem);
    }
  }

  /* Desktop: grid editorial de 12 colunas, padrão de 10 posições:
     [média + menor deslocada] [3 em degraus] [menor + média] [3 em degraus].
     Cards de 4–5 colunas: cada obra cabe inteira na tela do notebook.
     `:nth-child(… of :not([hidden]))` recalcula o padrão quando o filtro
     esconde itens — sem JavaScript para o layout. */
  @media (min-width: 1024px) {
    .obras {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
      row-gap: clamp(3rem, 1.5rem + 3vw, 5rem);
    }

    .obra:nth-child(10n + 1 of :not([hidden])) {
      grid-column: 1 / span 5;
    }
    .obra:nth-child(10n + 2 of :not([hidden])) {
      grid-column: 8 / span 4;
      margin-top: clamp(3rem, 7vw, 7rem);
    }
    .obra:nth-child(10n + 3 of :not([hidden])),
    .obra:nth-child(10n + 8 of :not([hidden])) {
      grid-column: 1 / span 4;
    }
    .obra:nth-child(10n + 4 of :not([hidden])),
    .obra:nth-child(10n + 9 of :not([hidden])) {
      grid-column: 5 / span 4;
      margin-top: clamp(2rem, 5vw, 5rem);
    }
    .obra:nth-child(10n + 5 of :not([hidden])),
    .obra:nth-child(10n + 10 of :not([hidden])) {
      grid-column: 9 / span 4;
      margin-top: clamp(1rem, 2.5vw, 2.5rem);
    }
    .obra:nth-child(10n + 6 of :not([hidden])) {
      grid-column: 2 / span 4;
      margin-top: clamp(3rem, 6vw, 6rem);
    }
    .obra:nth-child(10n + 7 of :not([hidden])) {
      grid-column: 7 / span 5;
    }
  }

  /* ---- CTA ---- */
  .trabalhos__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem 2rem;
    margin-top: clamp(3rem, 1.5rem + 4vw, 5.5rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .trabalhos__cta p {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    line-height: 1.1;
    max-width: 22ch;
  }

  /* ---- Lightbox ----
     Entrada com @starting-style (sem JS): esmaece e a obra cresce de 96%
     (nunca de 0 — nada no mundo real surge do nada). Saída mais curta. */
  .lightbox {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    padding: 0;
    border: 0;
    background: #0e0e0d; /* opaco: 3% de transparência já deixava a página clara "vazar" */
    color: var(--on-ink);
    opacity: 0;
    transition:
      opacity 200ms ease,
      overlay 200ms allow-discrete,
      display 200ms allow-discrete;
  }

  .lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    opacity: 1;
    transition-duration: var(--dur-ui);
  }

  .lightbox::backdrop {
    background: transparent;
  }

  .lightbox__figura {
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    min-height: 0;
    padding: 0 var(--gutter) max(1.25rem, env(safe-area-inset-bottom));
    transform: scale(0.96);
    transition: transform 200ms var(--ease-out);
  }

  .lightbox[open] .lightbox__figura {
    transform: none;
    transition-duration: 400ms;
  }

  @starting-style {
    .lightbox[open] {
      opacity: 0;
    }

    .lightbox[open] .lightbox__figura {
      transform: scale(0.96);
    }
  }

  .lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem var(--gutter);
  }

  .lightbox__contador {
    font-size: var(--step--1);
    font-variant-numeric: tabular-nums;
    color: var(--on-ink-soft);
  }

  .lightbox__fechar {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .lightbox :global(.lightbox__icone) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .lightbox__palco {
    display: grid;
    place-items: center;
    min-height: 0;
    touch-action: pan-y;
  }

  .lightbox__img,
  .lightbox__video {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    min-height: 0;
  }

  .lightbox__img[hidden],
  .lightbox__video[hidden] {
    display: none;
  }

  .lightbox__legenda {
    display: grid;
    gap: 0.75rem 2rem;
    padding-top: 1.25rem;
    margin-top: 1.25rem;
    border-top: 1px solid var(--line-on-ink);
  }

  .lightbox__meta {
    font-size: var(--step--1);
    color: var(--on-ink-soft);
  }

  .lightbox__titulo {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
  }

  .lightbox__descricao {
    max-width: 60ch;
    color: var(--on-ink-soft);
  }

  .lightbox__nav {
    display: flex;
    gap: 0.5rem;
  }

  .lightbox__seta {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--line-on-ink);
    border-radius: 50%;
    transition:
      background-color var(--dur-hover) ease,
      color var(--dur-hover) ease,
      transform var(--dur-press) var(--ease-out);
  }

  .lightbox__seta:active {
    transform: scale(0.94);
  }

  @media (hover: hover) and (pointer: fine) {
    .lightbox__seta:hover {
      background: var(--on-ink);
      color: var(--ink);
    }
  }

  @media (min-width: 900px) {
    .lightbox__legenda {
      grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) auto;
      align-items: end;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lightbox__figura,
    .lightbox[open] .lightbox__figura {
      transform: none;
    }
  }
</style>
