---
/**
 * Cabeçalho de seção reutilizável. Corrige a inconsistência anterior:
 * os estilos de título estavam presos (escopo) dentro de Sobre.astro,
 * então só aquela seção ficava formatada.
 *
 * Slots: default = título (h2) · "intro" = texto de apoio · "aside" = filtros etc.
 */
interface Props {
  index: string;
  label: string;
  titleId?: string;
}

const { index, label, titleId } = Astro.props;
---

<header class="sh">
  <div class="sh__top">
    <p class="label"><span class="label__index">({index})</span>{label}</p>
    {Astro.slots.has('aside') && <div class="sh__aside"><slot name="aside" /></div>}
  </div>
  <div class="sh__body">
    <h2 class="sh__title" id={titleId}><slot /></h2>
    {Astro.slots.has('intro') && <div class="sh__intro"><slot name="intro" /></div>}
  </div>
</header>

<style>
  .sh {
    display: grid;
    gap: clamp(1.25rem, 0.5rem + 2vw, 2.5rem);
    margin-bottom: clamp(2rem, 1rem + 2.5vw, 3.5rem);
  }

  .sh__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--sh-line, var(--line));
  }

  .sh__body {
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }

  .sh__title {
    font-size: var(--step-3);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 16ch;
  }

  .sh__intro {
    max-width: 42ch;
    color: var(--sh-soft, var(--ink-soft));
    font-size: var(--step-1);
    line-height: 1.45;
  }

  @media (min-width: 900px) {
    .sh__body {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--col-gap);
    }

    .sh__intro {
      justify-self: end;
    }
  }
</style>
