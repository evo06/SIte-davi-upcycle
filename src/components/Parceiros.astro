---
import { Image } from 'astro:assets';
import SectionHeader from './SectionHeader.astro';
import corona from '../assets/parceiros/corona.png';
import globo from '../assets/parceiros/globo.webp';
import sesc from '../assets/parceiros/sesc.png';
import shell from '../assets/parceiros/shell.webp';

// Cada marca ligada à obra que fez com o Davi: mostra prova, não só logo.
const parceiros = [
  { nome: 'TV Globo', logo: globo, projetos: ['Escultura Onda'], altura: 58 },
  { nome: 'Shell', logo: shell, projetos: ['Escultura com leques'], altura: 64 },
  { nome: 'Corona', logo: corona, projetos: ['Planeta Pet'], altura: 54 },
  { nome: 'Sesc', logo: sesc, projetos: ['Banco Sol', 'Peixe'], altura: 48 },
];
---

<section class="parceiros" id="parceiros" aria-labelledby="parceiros-titulo">
  <!-- Tom monocromático dos logos: tira a cor e aplica uma curva gama.
       A gama escurece os tons médios (o gradiente do Globo ficava cinza-claro
       com grayscale puro) mas mantém o branco branco, então o fundo branco
       do logo da Shell continua sumindo no papel com o multiply. -->
  <svg class="sr-only" aria-hidden="true" focusable="false">
    <filter id="tom-logo" color-interpolation-filters="sRGB">
      <feColorMatrix type="saturate" values="0" />
      <feComponentTransfer>
        <feFuncR type="gamma" amplitude="1" exponent="2.6" offset="0" />
        <feFuncG type="gamma" amplitude="1" exponent="2.6" offset="0" />
        <feFuncB type="gamma" amplitude="1" exponent="2.6" offset="0" />
      </feComponentTransfer>
    </filter>
  </svg>

  <div class="container">
    <SectionHeader index="03" label="Parceiros" titleId="parceiros-titulo">
      Marcas que <em class="serif">já encomendaram</em>
      <p slot="intro">Globo, Shell, Corona e Sesc encomendaram peças feitas com resíduos.</p>
    </SectionHeader>

    <ul class="marcas">
      {
        parceiros.map((p) => (
          <li class="marca">
            <div class="marca__logo">
              <Image
                src={p.logo}
                alt={p.nome}
                height={p.altura * 2}
                style={`--altura:${p.altura}px`}
                loading="lazy"
                decoding="async"
              />
            </div>
            <p class="marca__projeto">
              <span class="marca__rotulo">{p.projetos.length > 1 ? 'Projetos' : 'Projeto'}</span>
              <span>{p.projetos.join(' e ')}</span>
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .parceiros {
    padding-block: var(--section-space);
  }

  .marcas {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .marca {
    display: grid;
    grid-template-rows: 1fr auto;
    gap: 1rem;
    padding: clamp(1rem, 0.6rem + 1.2vw, 1.5rem);
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .marca__logo {
    display: grid;
    place-items: center;
    min-height: clamp(5rem, 3.5rem + 4vw, 8rem);
  }

  /* Logos em tons de cinza e fundidos ao papel (multiply some com o branco):
     uma faixa uniforme em vez de 4 manchas de cor competindo com as obras. */
  .marca__logo :global(img) {
    width: auto;
    height: var(--altura);
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: url(#tom-logo);
    mix-blend-mode: multiply;
  }

  .marca__projeto {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: var(--step--1);
    font-weight: 500;
  }

  .marca__rotulo {
    color: var(--ink-soft);
    font-weight: 400;
  }

  @media (min-width: 900px) {
    .marcas {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 480px) {
    .marca__logo :global(img) {
      height: calc(var(--altura) * 0.7);
    }

    .marca__projeto {
      flex-direction: column;
      gap: 0.15rem;
    }
  }
</style>
