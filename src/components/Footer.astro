---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE } from '../data/site';

const ano = new Date().getFullYear();
---

<footer class="footer" data-tema="escuro">
  <div class="container">
    <div class="footer__linha">
      <div class="footer__marca">
        <Logo class="footer__logo" />
        <p>{SITE.slogan}</p>
      </div>

      <nav aria-label="Rodapé">
        <ul class="footer__nav">
          {
            NAV.map((item) => (
              <li>
                <a class="link-sutil" href={item.href}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="footer__social">
        <a class="link-sutil footer__insta" href={SITE.instagram.url} target="_blank" rel="noopener noreferrer">
          <Icon name="instagram" class="footer__icone" />
          {SITE.instagram.usuario}
        </a>
        <a class="link-sutil" href="#topo">
          Voltar ao topo
          <Icon name="arrow-n" class="footer__icone" />
        </a>
      </div>
    </div>

    <!-- Assinatura monumental: decorativa (o nome já está no header). -->
    <p class="footer__assinatura" aria-hidden="true">Davi Rezende</p>

    <p class="footer__copy">© {ano} {SITE.nome}. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .footer {
    padding-top: clamp(4rem, 2rem + 6vw, 7rem);
    padding-bottom: max(1.5rem, env(safe-area-inset-bottom));
    background: var(--ink);
    color: var(--on-ink);
    overflow: hidden;
  }

  .footer__linha {
    display: grid;
    gap: 2.5rem var(--col-gap);
    padding-top: 2rem;
    border-top: 1px solid var(--line-on-ink);
  }

  .footer__marca {
    display: grid;
    gap: 1rem;
    color: var(--on-ink-soft);
    max-width: 22ch;
  }

  .footer :global(.footer__logo) {
    width: 2.5rem;
    color: var(--on-ink);
  }

  .footer__nav,
  .footer__social {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .link-sutil {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2rem;
    color: var(--on-ink-soft);
    transition: color var(--dur-hover) ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .link-sutil:hover {
      color: var(--on-ink);
    }
  }

  .footer :global(.footer__icone) {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* O nome ocupa a largura toda: assinatura de catálogo. */
  .footer__assinatura {
    margin-top: clamp(3rem, 2rem + 5vw, 6rem);
    /* Tamanho derivado da largura útil: a palavra mede ~5,1× o corpo da
       fonte, então largura / 5,15 preenche a linha sem estourar. */
    font-size: min(calc((100vw - 2 * var(--gutter)) / 5.15), calc(var(--max-width) / 5.15));
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.055em;
    white-space: nowrap;
    color: var(--on-ink);
    user-select: none;
  }

  .footer__copy {
    margin-top: 2rem;
    font-size: var(--step--1);
    color: var(--on-ink-soft);
  }

  @media (min-width: 768px) {
    .footer__linha {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }
</style>
