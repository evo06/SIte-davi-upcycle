---
import { getImage } from 'astro:assets';

// Fontes self-hosted: sem requisição ao Google (privacidade/LGPD e
// menos uma conexão bloqueando a renderização).
import '@fontsource-variable/bricolage-grotesque/opsz.css';
import '@fontsource/instrument-serif/400-italic.css';
import fonteDisplay from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-opsz-normal.woff2?url';
import '../styles/global.css';

import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import InstagramToast from '../components/InstagramToast.astro';
import { SITE } from '../data/site';
import imagemCompartilhamento from '../assets/hero/planeta-pet-horizontal.jpg';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.titulo, description = SITE.descricao } = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonical = new URL(Astro.url.pathname, site);
const og = await getImage({ src: imagemCompartilhamento, width: 1200, height: 630, format: 'jpg' });
const ogUrl = new URL(og.src, site);

// Dados estruturados: ajudam o Google a entender quem é o artista,
// onde atua e como contatar (pode gerar resultados mais ricos na busca).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.nome,
  jobTitle: 'Artista e designer de upcycling',
  description,
  url: site.href,
  image: ogUrl.href,
  email: `mailto:${SITE.email}`,
  telephone: '+55-21-98222-1872',
  sameAs: [SITE.instagram.url],
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.endereco.rua,
    addressLocality: 'Rio de Janeiro',
    addressRegion: 'RJ',
    postalCode: SITE.endereco.cep,
    addressCountry: 'BR',
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#f2f0ea" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <link rel="apple-touch-icon" href="/images/favicon.png" />

    <!-- Open Graph: cartão bonito ao compartilhar no WhatsApp/Instagram/LinkedIn -->
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={SITE.nome} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Pré-carrega a fonte principal para o título aparecer sem "piscar". -->
    <link rel="preload" href={fonteDisplay} as="font" type="font/woff2" crossorigin />

    <!-- Marca que o JS está ativo antes da primeira pintura: os estados
         "escondidos" das revelações só existem quando o JS pode desfazê-los. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <slot />
    <WhatsAppFloat />
    <InstagramToast />

    <script>
      // Revela imagens marcadas com .reveal quando entram na tela — uma vez só.
      // (Reanimar a cada passagem do scroll cansa e vira ruído.)
      const reduz = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const alvos = document.querySelectorAll<HTMLElement>('.reveal');

      if (reduz || !('IntersectionObserver' in window)) {
        alvos.forEach((el) => el.classList.add('is-revealed'));
      } else {
        const observer = new IntersectionObserver(
          (entradas) => {
            for (const entrada of entradas) {
              if (!entrada.isIntersecting) continue;
              entrada.target.classList.add('is-revealed');
              observer.unobserve(entrada.target);
            }
          },
          { rootMargin: '0px 0px -12% 0px' },
        );
        alvos.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
